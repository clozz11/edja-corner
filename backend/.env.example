# === Backend Edja Corner — contoh environment ===
# Salin file ini jadi .env lalu isi nilainya. JANGAN commit .env asli.

# Mode
NODE_ENV=development
PORT=3000

# Database PostgreSQL
# Opsi 1 (disarankan, dipakai Render): satu connection URL
# Render -> service PostgreSQL -> "Internal Database URL"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/edja_corner

# Opsi 2 (alternatif): variabel terpisah (dipakai kalau DATABASE_URL kosong)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=edja_corner
# DB_USER=postgres
# DB_PASSWORD=

# JWT — ganti dengan string acak panjang di produksi
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
